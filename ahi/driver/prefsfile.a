
	incdir	include:
	include	devices/ahi.i
	include	libraries/ahi_sub.i

TRUE		EQU	1
FALSE		EQU	0

* Private tags of the hardware-mixing modes. AHIDB_UserBase is where the
* AHI developer includes put a driver's own tags; the NDK copy has no name.
AHIDB_ZZVoice		EQU	AHI_TagBase+500
AHIDB_ZZVoiceLinear	EQU	AHI_TagBase+501
AHIDB_ZZVoiceCubic	EQU	AHI_TagBase+502

BEG:

*** FORM AHIM
	dc.l	ID_FORM
	dc.l	E-S
S:
	dc.l	ID_AHIM

*** AUDN
	dc.l	ID_AUDN
	dc.l	.e-.s
.s:
	dc.b	"zz9000ax",0,0
.e:
	CNOP	0,2

*** AUDM
ModeA:
	dc.l	ID_AUDM
	dc.l	.e-.s
.s
	dc.l	AHIDB_AudioID,		$CAFE0000

	dc.l	AHIDB_Volume,		TRUE
	dc.l	AHIDB_Panning,		TRUE
	dc.l	AHIDB_Stereo,		TRUE
	dc.l	AHIDB_HiFi,			FALSE

	dc.l	AHIDB_Name,		.name-.s
	dc.l	TAG_DONE
.name	dc.b	"ZZ9000AX:16 bit Stereo++",0
.e
	CNOP	0,2

*** AUDM
ModeB:
	dc.l	ID_AUDM
	dc.l	.e-.s
.s
	dc.l	AHIDB_AudioID,		$CAFE0001

	dc.l	AHIDB_Volume,		TRUE
	dc.l	AHIDB_Panning,		FALSE
	dc.l	AHIDB_Stereo,		TRUE
	dc.l	AHIDB_HiFi,			FALSE

	dc.l	AHIDB_Name,		.name-.s
	dc.l	TAG_DONE
.name	dc.b	"ZZ9000AX:16 bit Stereo",0
.e
	CNOP	0,2
*** AUDM
* Hardware mixing: ahi.device mixes nothing, the driver maps every AHI
* channel to a voice of the card's voice engine. The private tags name the
* mode for the driver (AHIDB_ZZVoice nearest, AHIDB_ZZVoiceLinear interpolated,
* AHIDB_ZZVoiceCubic 4-point cubic interpolation); their data is the mode id.
* $CAFE0000 to $CAFE0003 keep their meaning: $CAFE0004 is a separate mode.
ModeC:
	dc.l	ID_AUDM
	dc.l	.e-.s
.s
	dc.l	AHIDB_AudioID,		$CAFE0002
	dc.l	AHIDB_ZZVoice,		$CAFE0002

	dc.l	AHIDB_Volume,		TRUE
	dc.l	AHIDB_Panning,		TRUE
	dc.l	AHIDB_Stereo,		TRUE
	dc.l	AHIDB_HiFi,			FALSE
	dc.l	AHIDB_PingPong,		TRUE

	dc.l	AHIDB_Name,		.name-.s
	dc.l	TAG_DONE
.name	dc.b	"ZZ9000AX:Hardware mixing, 32 voices",0
.e
	CNOP	0,2

*** AUDM
ModeD:
	dc.l	ID_AUDM
	dc.l	.e-.s
.s
	dc.l	AHIDB_AudioID,		$CAFE0003
	dc.l	AHIDB_ZZVoiceLinear,	$CAFE0003

	dc.l	AHIDB_Volume,		TRUE
	dc.l	AHIDB_Panning,		TRUE
	dc.l	AHIDB_Stereo,		TRUE
	dc.l	AHIDB_HiFi,			FALSE
	dc.l	AHIDB_PingPong,		TRUE

	dc.l	AHIDB_Name,		.name-.s
	dc.l	TAG_DONE
.name	dc.b	"ZZ9000AX:Hardware mixing, 32 voices, interpolated",0
.e
	CNOP	0,2

*** AUDM
ModeE:
	dc.l	ID_AUDM
	dc.l	.e-.s
.s
	dc.l	AHIDB_AudioID,		$CAFE0004
	dc.l	AHIDB_ZZVoiceCubic,	$CAFE0004

	dc.l	AHIDB_Volume,		TRUE
	dc.l	AHIDB_Panning,		TRUE
	dc.l	AHIDB_Stereo,		TRUE
	dc.l	AHIDB_HiFi,			FALSE
	dc.l	AHIDB_PingPong,		TRUE

	dc.l	AHIDB_Name,		.name-.s
	dc.l	TAG_DONE
.name	dc.b	"ZZ9000AX:Hardware mixing, 32 voices, cubic",0
.e
	CNOP	0,2

E:
	CNOP	0,2
